# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# ---- Owner profile defaults (all overridable later from the web setup wizard) ----
AJITH_NAME=Ajith
AJITH_ROLE=Personal Assistant
ASSISTANT_NAME=Assistant
AJITH_AVAILABILITY=UNAVAILABLE
# Only needed if you want to hard-set this instead of letting it auto-detect
# from the logged-in WhatsApp session (see index.js).
AJITH_WHATSAPP_JID=

# ---- Contact-facing AI (existing — auto-replies to contacts, and the
# /summary pending-conversation summary and setup-wizard prompt generation) ----
NVIDIA_API_KEY=
NVIDIA_MODEL=

# ---- Owner-facing AI (tasks/reminders/notes/links/search/status/chat via
# your own self-chat — see ownerAssistant.js). Slash commands like /task,
# /note, /remind, /save work even without this set; natural-language
# routing and normal chat need it. ----
GROQ_API_KEY=
GROQ_MODEL=

# Fixed UTC offset (in minutes) used to resolve "tomorrow 10am"-style
# reminder times. Default 330 = IST (UTC+5:30), which has no DST. If you're
# in a timezone that observes DST, you'll need to update this twice a year.
ASSISTANT_TIMEZONE_OFFSET_MINUTES=330

# ---- Web setup UI ----
# Verification code gating the QR/dashboard screen (see access.js).
ASSISTANT_ACCESS_CODE=
WEB_HOST=localhost
WEB_PORT=3000
